---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Translations } from '../i18n/en';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  t: Translations['footer'];
  lang: Lang;
}

const { t, lang } = Astro.props;

// Reuse the nav labels for the footer link columns.
const nav = useTranslations(lang).nav;

const linkColumns = [
  {
    title: nav.freeTools,
    links: [
      { href: '/tools/ats-resume-checker', label: nav.atsChecker },
      { href: '/tools/resume-bullet-point-generator', label: nav.bulletGenerator },
    ],
  },
  {
    title: nav.resources,
    links: [
      { href: '/resume-skills', label: nav.resumeSkills },
    ],
  },
];
---

<footer style="padding: 3rem 1.5rem 2.5rem;">
  <div style="max-width: 1180px; margin: 0 auto;">

    <div class="footer-top" style="margin-bottom: 2rem;">

      <!-- Logo + tagline -->
      <div class="footer-brand">
        <a
          href={lang === 'en' ? '/' : `/${lang}/`}
          style="
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            margin-bottom: 0.375rem;
          "
          aria-label="Hirime — Home"
        >
          <span style="
            font-family: 'Onest', system-ui, sans-serif;
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            color: var(--text-primary);
          ">Hirime</span>
          <span style="
            width: 5px; height: 5px;
            border-radius: 50%;
            background-color: var(--accent);
            display: inline-block;
          " aria-hidden="true"></span>
        </a>
        <p style="font-size: 0.875rem; color: var(--text-muted);">
          {t.tagline}
        </p>
        <div style="margin-top: 1.25rem;">
          <LanguageSwitcher currentLang={lang} />
        </div>
      </div>

      <!-- Link columns -->
      {linkColumns.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <h3 class="footer-col-title">{col.title}</h3>
          <ul class="footer-col-list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <!-- Company column -->
      <nav class="footer-col" aria-label={t.company}>
        <h3 class="footer-col-title">{t.company}</h3>
        <ul class="footer-col-list">
          <li><a href="/about" class="footer-link">{t.links.about}</a></li>
          <li><a href="/privacy" class="footer-link">{t.links.privacy}</a></li>
          <li><a href="/terms" class="footer-link">{t.links.terms}</a></li>
          <li><a href="mailto:hello@hirime.com" class="footer-link">{t.links.contact}</a></li>
        </ul>
      </nav>

    </div>

    <!-- Bottom bar -->
    <div style="
      border-top: 1px solid var(--border);
      padding-top: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    ">
      <p style="font-size: 0.8125rem; color: var(--text-muted);">
        {t.copyright}
      </p>
      <p style="font-size: 0.8125rem; color: var(--text-muted);">
        Made with <span aria-label="love" style="color: var(--accent);">♥</span> for job seekers
      </p>
    </div>

  </div>
</footer>

<style>
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer-brand {
    max-width: 22rem;
  }
  .footer-col-title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 0.875rem;
  }
  .footer-col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
  }
</style>
