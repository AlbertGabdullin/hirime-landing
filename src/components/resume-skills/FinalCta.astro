---
// Early-access waitlist CTA — mirrors the home page "Get early access /
// Be the first to know" section. The Hirime resume builder isn't launched
// yet, so this captures emails via the shared `.waitlist-form` handler wired
// in BaseLayout (posts to /api/waitlist) instead of linking to a live builder.

interface Props {
  // The "generate skills first" link points at #generator, which only exists
  // on individual profession pages — not the /resume-skills list page.
  showGenerateLink?: boolean;
}

const { showGenerateLink = true } = Astro.props;
---

<section id="build">
  <div class="container">
    <div class="final-cta">
      <span class="eyebrow"><span class="spark">✦</span> Get early access</span>
      <h2>Be the first to <span class="serif-em">know.</span></h2>
      <p>Hirime's AI resume builder is launching soon. Join the waitlist and we'll email you the moment it's ready — plus early-access perks for job seekers.</p>

      <form class="waitlist-form fc-form" novalidate>
        <div class="fc-form-row">
          <input
            type="email"
            name="email"
            required
            placeholder="Enter your email address"
            class="email-input"
            aria-label="Enter your email address"
          />
          <button type="submit" class="btn btn-primary btn-lg">Join the waitlist</button>
        </div>
        <div class="success-msg fc-success">
          <span>✓</span>
          <span>You're on the list! We'll be in touch soon. 🎉</span>
        </div>
      </form>

      {showGenerateLink && (
        <a class="fc-secondary" href="#generator">Or generate your skills first →</a>
      )}
    </div>
  </div>
</section>

<style>
  .fc-form {
    position: relative;
    max-width: 460px;
    margin: 0 auto;
  }
  .fc-form-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .fc-form-row .email-input {
    flex: 1;
    min-width: 220px;
  }
  .fc-form-row .btn {
    white-space: nowrap;
  }
  .fc-success {
    margin-top: 14px;
    justify-content: center;
  }
  .fc-secondary {
    position: relative;
    display: inline-block;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 500;
    color: inherit;
    opacity: 0.72;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .fc-secondary:hover {
    opacity: 1;
  }
</style>