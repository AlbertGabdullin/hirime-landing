---
import RichText from './RichText.astro';

interface Props {
  jobDescriptionExample: {
    excerpt: string;
    prioritizedSkills: string[];
  };
}

const { jobDescriptionExample } = Astro.props;
---

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><span class="spark">✦</span> Tailoring</span>
      <h2>Match your skills to the job description</h2>
      <p>ATS rank you partly on how well your resume echoes the posting. Mirror the skills a job names — in your own true words — and prioritize them near the top.</p>
    </div>
    <div class="jd-grid">
      <div class="jd-post">
        <span class="kicker">Job description excerpt</span>
        <p class="quote"><RichText text={jobDescriptionExample.excerpt} /></p>
      </div>
      <div class="jd-out">
        <span class="kicker">Skills to prioritize</span>
        <div class="jo-pills">
          {jobDescriptionExample.prioritizedSkills.map((s) => (
            <div class="jo">
              <span class="ck">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              {s}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
