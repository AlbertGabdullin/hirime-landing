---
interface RelatedLink {
  title: string;
  href: string;
}
interface Props {
  related: RelatedLink[];
}

const { related } = Astro.props;
---

{
  related.length > 0 && (
    <section style="padding-top: 0;">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow"><span class="spark">✦</span> Related</span>
          <h2>Explore skills for similar roles</h2>
        </div>
        <div class="related">
          {related.map((r) => (
            <a class="rel-link" href={r.href}>{r.title} <span class="ar">→</span></a>
          ))}
        </div>
      </div>
    </section>
  )
}
