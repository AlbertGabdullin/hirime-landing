---
import { parseRichText } from '../../lib/richText';

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = parseRichText(text);
---

{
  segments.map((seg) =>
    seg.kind === 'serif' ? (
      <span class="serif-em">{seg.text}</span>
    ) : seg.kind === 'mark' ? (
      <mark>{seg.text}</mark>
    ) : (
      <Fragment>{seg.text}</Fragment>
    ),
  )
}
