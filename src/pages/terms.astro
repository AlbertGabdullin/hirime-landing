---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { en as t } from '../i18n/en';

const lang = 'en' as const;
---

<BaseLayout t={t} lang={lang}>
  <Navbar t={t.nav} lang={lang} />
  <main style="padding: 7rem 1.5rem 5rem;">
    <div style="max-width: 720px; margin: 0 auto;">

      <!-- Header -->
      <div style="margin-bottom: 3rem;">
        <p style="
          font-size: 0.8125rem;
          font-weight: 600;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--accent);
          margin-bottom: 0.75rem;
        ">Legal</p>
        <h1 style="
          font-family: 'Instrument Serif', Georgia, serif;
          font-size: clamp(2rem, 5vw, 3rem);
          font-weight: 400;
          line-height: 1.15;
          color: var(--text-primary);
          margin-bottom: 1rem;
        ">Terms of Service</h1>
        <p style="font-size: 0.9375rem; color: var(--text-muted);">
          Last updated: April 14, 2025
        </p>
      </div>

      <!-- Content -->
      <div class="prose-content">

        <section>
          <p>
            These Terms of Service ("Terms") govern your access to and use of hirime.com and any services
            offered by Hirime ("we", "us", or "our"). By using our site or joining our waitlist, you agree
            to these Terms. If you do not agree, please do not use the site.
          </p>
        </section>

        <section>
          <h2>1. The Service</h2>
          <p>
            Hirime is an AI-powered resume builder. During the pre-launch phase, the site provides
            informational content, free tools, and a waitlist for early access. Features described on the
            site are subject to change as the product evolves, and some may not yet be available.
          </p>
        </section>

        <section>
          <h2>2. Waitlist & Early Access</h2>
          <p>
            Joining the waitlist does not guarantee access, pricing, or availability of any specific feature.
            We may invite waitlist members to early access on a rolling basis and may change or discontinue
            the waitlist at any time.
          </p>
        </section>

        <section>
          <h2>3. Acceptable Use</h2>
          <ul>
            <li>Do not use the site for any unlawful, harmful, or fraudulent purpose.</li>
            <li>Do not attempt to disrupt, reverse engineer, or gain unauthorized access to our systems.</li>
            <li>Do not submit content you do not have the right to share.</li>
          </ul>
          <p>We may suspend or terminate access for anyone who violates these Terms.</p>
        </section>

        <section>
          <h2>4. Your Content</h2>
          <p>
            When you use our tools, you may provide text such as job descriptions or resume details. You
            retain ownership of the content you submit. You grant us a limited license to process that
            content solely to provide the requested feature (for example, generating suggestions).
          </p>
        </section>

        <section>
          <h2>5. Intellectual Property</h2>
          <p>
            The Hirime name, logo, site design, and content are owned by us and protected by applicable
            intellectual property laws. You may not copy, distribute, or create derivative works without our
            permission.
          </p>
        </section>

        <section>
          <h2>6. Disclaimers</h2>
          <p>
            The site and tools are provided "as is" and "as available" without warranties of any kind.
            AI-generated suggestions may contain errors and should be reviewed before use. We do not
            guarantee any particular outcome, including job interviews or offers.
          </p>
        </section>

        <section>
          <h2>7. Limitation of Liability</h2>
          <p>
            To the fullest extent permitted by law, Hirime will not be liable for any indirect, incidental,
            or consequential damages arising from your use of the site or tools.
          </p>
        </section>

        <section>
          <h2>8. Changes to These Terms</h2>
          <p>
            We may update these Terms as our product evolves. When we do, we'll update the "Last updated"
            date above. Continued use of the site after changes means you accept the revised Terms.
          </p>
        </section>

        <section>
          <h2>9. Contact</h2>
          <p>
            Questions about these Terms? Reach us at <a href="mailto:hello@hirime.com">hello@hirime.com</a>.
          </p>
        </section>

      </div>
    </div>
  </main>
  <Footer t={t.footer} lang={lang} />
</BaseLayout>

<style>
  .prose-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .prose-content section {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .prose-content h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .prose-content p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .prose-content ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  .prose-content li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .prose-content a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-content a:hover {
    color: var(--accent-hover);
  }

  .prose-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .prose-content section:not(:last-child) {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
</style>
